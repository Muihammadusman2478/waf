import ipaddress, sys
src, dst = sys.argv[1:]
addresses = {ipaddress.ip_address(x.strip()) for x in open(src) if x.strip()}
if len(addresses) != 69:
    raise SystemExit(f'ERROR: Expected 69 BlogVault addresses, found {len(addresses)}.')
with open(dst, 'w') as f:
    f.write('# Hardcoded BlogVault IP addresses (WordPress Site Manager)\n')
    for ip in sorted(addresses, key=lambda x: (x.version, int(x))):
        f.write(f'{ip} 1;\n')
print(f'BlogVault IPs: {len(addresses)}')
