# Prepare application vhost, geo at http level, server-wide enforcement.
python3 - "$SITE" "$WORK/site.new" "$APP" <<'PY'
from pathlib import Path
import re, sys
site, destination, app = sys.argv[1:]
content = Path(site).read_text()
servers = list(re.finditer(r'(?m)^\s*server\s*\{', content))
if len(servers) != 1:
    raise SystemExit(f'ERROR: Expected exactly one server block, found {len(servers)}; no changes made.')
# Disallow some recognizable, previously installed broad-access patterns.
if re.search(r'geo\s+\$realip_remote_addr\s+\$\w+\s*\{|CW_WAF_', content):
    raise SystemExit('ERROR: Existing geo/WAF rule detected; review migration manually.')
variable = 'cw_waf_allowed_' + app.replace('-', '_')
geo = f'''# CW_WAF_ALLOW_START
geo $realip_remote_addr ${variable} {{
    default 0;
    include /etc/nginx/waf-allowedIPs;
    include /etc/nginx/waf-blogvault-IPs;
}}
# CW_WAF_ALLOW_END

'''
# A server-level if evaluates all URI locations (not just @backend).
match = servers[0]
enforce = f'''
    # CW_WAF_ENFORCEMENT_START
    if (${variable} = 0) {{
        return 403;
    }}
    # CW_WAF_ENFORCEMENT_END
'''
content = content[:match.end()] + enforce + content[match.end():]
Path(destination).write_text(geo + content)
PY

# Snapshot original vhost AND shared files before altering them.
BACKUP="$BACKUP_BASE/waf-backup-$(date +%Y%m%d-%H%M%S)-$APP"
mkdir -m 700 "$BACKUP"
cp -a "$SITE" "$BACKUP/vhost.original.conf"
for FILE in "$CF_FILE" "$BV_FILE"; do
    NAME=$(basename "$FILE")
    if [[ -e "$FILE" ]]; then
        cp -a "$FILE" "$BACKUP/$NAME"
    else
        touch "$BACKUP/$NAME.absent"
    fi
done
printf 'APP=%s\nSITE=%s\nCF_SOURCE=%s\n' "$APP" "$SITE" "$CF_SOURCE" > "$BACKUP/manifest.txt"

CHANGED=0
restore() {
    echo 'ERROR: Restoring original vhost and allowlist files...' >&2
    cp -a "$BACKUP/vhost.original.conf" "$SITE"
    for FILE in "$CF_FILE" "$BV_FILE"; do
        NAME=$(basename "$FILE")
        if [[ -f "$BACKUP/$NAME.absent" ]]; then rm -f "$FILE"
        else cp -a "$BACKUP/$NAME" "$FILE"; fi
    done
    nginx -t || true
}
on_failure() {
    rc=$?
    trap - ERR
    if (( CHANGED )); then restore; systemctl reload nginx || true; fi
    echo "FAILED (exit $rc). Backup: $BACKUP" >&2
    exit "$rc"
}
trap on_failure ERR

CHANGED=1
install -m 644 "$WORK/cloudflare" "$CF_FILE"
install -m 644 "$WORK/blogvault" "$BV_FILE"
cat "$WORK/site.new" > "$SITE"
nginx -t
systemctl reload nginx
CHANGED=0
trap - ERR

echo "SUCCESS: WAF protection enabled for $APP"
echo "Vhost: $SITE"
echo "Cloudflare allowlist: $CF_FILE"
echo "BlogVault allowlist: $BV_FILE"
echo "Original files backed up: $BACKUP"
echo "Cloudflare entries: $(grep -c ' 1;' "$CF_FILE")"
echo "BlogVault entries: $(grep -c ' 1;' "$BV_FILE")"
echo "Nginx: $(systemctl is-active nginx)"
