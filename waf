#!/usr/bin/env bash
# Cloudways application WAF bypass prevention: Cloudflare + BlogVault only.
# Run as root. No network downloads. Backups: /var/cw/systeam/waf-backup-<timestamp>-<APP_ID>/
set -Eeuo pipefail

CF_SOURCE=/etc/nginx/proxies/cloudflare-realip.conf
CF_FILE=/etc/nginx/waf-allowedIPs
BV_FILE=/etc/nginx/waf-blogvault-IPs
BACKUP_BASE=/var/cw/systeam

[[ $EUID -eq 0 ]] || { echo 'ERROR: Run as root.' >&2; exit 1; }
command -v python3 >/dev/null || { echo 'ERROR: python3 missing.' >&2; exit 1; }
command -v flock >/dev/null || { echo 'ERROR: flock missing.' >&2; exit 1; }
exec 9>/var/lock/cw-wafallow.lock
flock -n 9 || { echo 'ERROR: Another WAF installer is running.' >&2; exit 1; }

APP=${1:-}
if [[ -z "$APP" ]]; then read -rp 'Enter application DB name / APP_ID: ' APP; fi
[[ $APP =~ ^[a-zA-Z0-9_-]+$ ]] || { echo 'ERROR: Invalid APP_ID.' >&2; exit 1; }

SITE="/etc/nginx/sites-available/$APP"
ENABLED="/etc/nginx/sites-enabled/$APP"
[[ -f "$SITE" && -f "$ENABLED" ]] || { echo 'ERROR: Application vhost missing.' >&2; exit 1; }
[[ $(readlink -f "$SITE") == "$(readlink -f "$ENABLED")" ]] || {
  echo 'ERROR: sites-enabled is not linked to the selected sites-available vhost.' >&2; exit 1;
}
[[ -f "$CF_SOURCE" ]] || { echo "ERROR: Missing $CF_SOURCE" >&2; exit 1; }
[[ -d "$BACKUP_BASE" ]] || { echo "ERROR: Missing $BACKUP_BASE" >&2; exit 1; }

# Refuse to apply on a broken baseline or stack legacy rules.
nginx -t || { echo 'ERROR: Existing Nginx config is invalid.' >&2; exit 1; }
if grep -Eq 'CW_WAF_ALLOW_START|CW_WAF_ENFORCEMENT_START|geo[[:space:]]+\$realip_remote_addr[[:space:]]+\$allowed' "$SITE"; then
  echo 'ERROR: Existing WAF customization found. Migrate it manually; no changes made.' >&2
  exit 1
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Only Cloudflare ranges; explicitly do NOT read cloudfront/ezoic/etc.
python3 - "$CF_SOURCE" "$WORK/cloudflare" <<'PY'
import ipaddress, re, sys
source, dest = sys.argv[1:]
nets = set()
for line in open(source):
    m = re.match(r'^\s*set_real_ip_from\s+(\S+);', line)
    if m:
        nets.add(ipaddress.ip_network(m.group(1), strict=False))
if len(nets) < 15 or not any(ipaddress.ip_address('162.159.136.54') in n and ipaddress.ip_address('162.159.137.54') in n for n in nets):
    raise SystemExit('ERROR: Cloudflare source is unexpectedly incomplete; no changes made.')
with open(dest, 'w') as f:
    f.write('# From /etc/nginx/proxies/cloudflare-realip.conf\n')
    for n in sorted(nets, key=lambda n: (n.version, int(n.network_address), n.prefixlen)):
        f.write(f'{n} 1;\n')
print(f'Cloudflare ranges: {len(nets)} (CFE IPs already covered)')
PY

